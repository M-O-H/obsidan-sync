{
	"nodes":[
		{"id":"ec0143648f9de21e","x":-100,"y":-460,"width":725,"height":470,"type":"text","text":"```dataviewjs\nconst html = `\n<div style=\"display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 30px; width: 100%; flex-wrap: wrap;\">\n  <!-- Left Side: Diagram (No Text) -->\n  <div style=\"flex: 1; min-width: 240px; max-width: 320px;\">\n    <svg viewBox=\"0 0 400 380\" style=\"width: 100%; height: auto;\">\n      <circle cx=\"200\" cy=\"130\" r=\"110\" fill=\"rgba(255, 99, 132, 0.3)\" stroke=\"#ff6384\" stroke-width=\"3\" />\n      <circle cx=\"130\" cy=\"240\" r=\"110\" fill=\"rgba(75, 192, 192, 0.3)\" stroke=\"#4bc0c0\" stroke-width=\"3\" />\n      <circle cx=\"270\" cy=\"240\" r=\"110\" fill=\"rgba(153, 102, 255, 0.3)\" stroke=\"#9966ff\" stroke-width=\"3\" />\n    </svg>\n  </div>\n\n  <!-- Right Side: Content -->\n  <div style=\"flex: 1.2; min-width: 260px; font-family: var(--font-interface); color: var(--text-normal); line-height: 1.5;\">\n    <h3 style=\"margin-top: 0; margin-bottom: 12px; color: var(--text-accent);\">3-Cycle Framework</h3>\n    \n    <div style=\"margin-bottom: 12px;\">\n      <strong style=\"color: var(--text-muted); text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px;\">Core Cycles</strong>\n      <ul style=\"margin: 4px 0 0 0; padding-left: 18px;\">\n        <li><span style=\"color: #ff6384;\">●</span> <strong>Passion:</strong> What you love to do</li>\n        <li><span style=\"color: #4bc0c0;\">●</span> <strong>Problem:</strong> What the world needs solved</li>\n        <li><span style=\"color: #9966ff;\">●</span> <strong>Payment:</strong> What someone will pay you to do</li>\n      </ul>\n    </div>\n\n    <div style=\"margin-bottom: 12px;\">\n      <strong style=\"color: var(--text-muted); text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px;\">Intersections</strong>\n      <ul style=\"margin: 4px 0 0 0; padding-left: 18px;\">\n        <li><strong>Mission:</strong> Passion + Problem</li>\n        <li><strong>Profession:</strong> Passion + Payment</li>\n        <li><strong>Vocation:</strong> Problem + Payment</li>\n      </ul>\n    </div>\n\n    <div>\n      <strong style=\"color: var(--text-muted); text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px;\">Center</strong>\n      <p style=\"margin: 4px 0 0 0; font-weight: bold; color: var(--interactive-accent);\">✨ Purpose / Sweet Spot</p>\n    </div>\n  </div>\n</div>\n`;\n\ndv.paragraph(html);\n```"}
	],
