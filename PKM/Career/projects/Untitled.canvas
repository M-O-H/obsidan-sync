	"nodes":[
		{"id":"ec0143648f9de21e","x":-125,"y":-440,"width":725,"height":470,"type":"text","text":"```dataviewjs\nconst html = `\n<div style=\"display: flex; justify-content: center; align-items: center; width: 100%;\">\n  <svg width=\"600\" height=\"520\" viewBox=\"0 0 600 520\" style=\"font-family: var(--font-interface); text-anchor: middle;\">\n    <!-- Circles -->\n    <circle cx=\"300\" cy=\"180\" r=\"140\" fill=\"rgba(255, 99, 132, 0.25)\" stroke=\"#ff6384\" stroke-width=\"2.5\" />\n    <circle cx=\"210\" cy=\"320\" r=\"140\" fill=\"rgba(75, 192, 192, 0.25)\" stroke=\"#4bc0c0\" stroke-width=\"2.5\" />\n    <circle cx=\"390\" cy=\"320\" r=\"140\" fill=\"rgba(153, 102, 255, 0.25)\" stroke=\"#9966ff\" stroke-width=\"2.5\" />\n\n    <!-- Main Outer Labels -->\n    <text x=\"300\" y=\"80\" fill=\"var(--text-normal)\" font-weight=\"bold\" font-size=\"16\">Passion</text>\n    <text x=\"300\" y=\"100\" fill=\"var(--text-muted)\" font-size=\"12\">(What you love)</text>\n\n    <text x=\"120\" y=\"420\" fill=\"var(--text-normal)\" font-weight=\"bold\" font-size=\"16\">World Need</text>\n    <text x=\"120\" y=\"440\" fill=\"var(--text-muted)\" font-size=\"12\">(Problem to solve)</text>\n\n    <text x=\"480\" y=\"420\" fill=\"var(--text-normal)\" font-weight=\"bold\" font-size=\"16\">Payment</text>\n    <text x=\"480\" y=\"440\" fill=\"var(--text-muted)\" font-size=\"12\">(Will someone pay?)</text>\n\n    <!-- Intersections -->\n    <text x=\"210\" y=\"210\" fill=\"var(--text-accent)\" font-weight=\"bold\" font-size=\"14\">Mission</text>\n    <text x=\"390\" y=\"210\" fill=\"var(--text-accent)\" font-weight=\"bold\" font-size=\"14\">Profession</text>\n    <text x=\"300\" y=\"395\" fill=\"var(--text-accent)\" font-weight=\"bold\" font-size=\"14\">Vocation</text>\n\n    <!-- Center Intersection -->\n    <text x=\"300\" y=\"275\" fill=\"var(--text-normal)\" font-weight=\"bold\" font-size=\"16\">Purpose</text>\n    <text x=\"300\" y=\"295\" fill=\"var(--text-muted)\" font-size=\"12\">(The Sweet Spot)</text>\n  </svg>\n</div>\n`;\n\ndv.paragraph(html);\n```"}
